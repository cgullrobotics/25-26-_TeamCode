    public void fieldCentricDriveTrain(){
        pinpoint.update();

        double y = -gamepad1.left_stick_y;
        double x = gamepad1.left_stick_x;
        double spin = gamepad1.right_stick_x;

        Pose2D pos = pinpoint.getPosition();
        double heading = Math.toRadians(pos.getHeading(AngleUnit.DEGREES));
        double rotX = y * Math.cos(-heading) - x * Math.sin(-heading);
        double rotY = y * Math.sin(-heading) + x * Math.cos(-heading);

        double fl = rotY + rotX + spin;
        double fr = rotY - rotX - spin;
        double bl = rotY - rotX + spin;
        double br = rotY + rotX - spin;

        double max = Math.max(1.0, Math.abs(fl));
        max = Math.max(max, Math.abs(fr));
        max = Math.max(max, Math.abs(bl));
        max = Math.max(max, Math.abs(br));

        fl /= max;
        fr /= max;
        bl /= max;
        br /= max;
        leftFront.setPower(fl);
        rightFront.setPower(fr);
        leftBack.setPower(bl);
        rightBack.setPower(br);

        telemetry.addData("X Pos", pos.getX(DistanceUnit.INCH));
        telemetry.addData("Y Pos", pos.getY(DistanceUnit.INCH));
        telemetry.addData("Heading", heading);

    }

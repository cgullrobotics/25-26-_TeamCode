    public void turretControl(){
        LLResult result = limelight.getLatestResult();
        double tx = 0;
        double ta = 0;
        double targetArea = 0;
        double motorPower = 0;


        if (result !=null&& result.isValid()){
            tx = result.getTx();
            double ty = result.getTy();
            ta = result.getTa();

            telemetry.addData("Target X", tx);
            telemetry.addData("Target Y", ty);
            telemetry.addData("Target Area", ta);

        }
        else {
            telemetry.addData("limelight","No targets");
        }

        double kP = 0.8;
        double kI = .2;
        double kD = 0.008;

// Variables for PID
        double previousError = 0;
        double integral = 0;

        double target = 0; // Desired tx value (centered on target)

// Inside your loop:
        double error = target - tx;

// Integral term (only accumulate when error is small to avoid windup)
        if (Math.abs(error) < 10) {
            integral += error;
        } else {
            integral = 0.0;
        }

// Derivative term
        double derivative = error - previousError;
        previousError = error;

// PID output
        double turnPower = (kP * error) + (kI * integral) + (kD * derivative);

// Clamp power to avoid excessive speed
        turnPower = Math.max(-.7, Math.min(.7, turnPower));
        if (Math.abs(error) < .8) {  // 1 degree or pixel, depending on tx units
            turnPower = .04;
        }

// Stop condition: target centered and close enough
        if (Math.abs(error) < 0 && ta > .4) {
            turret.setPower(0);
            telemetry.addData("Status", "Aligned!");
        } else {
            turret.setPower(-turnPower);
        }

        telemetry.addData("Error", error);
        telemetry.addData("Turn Power", turnPower);
        telemetry.addData("angle",angle.getPosition());
        telemetry.update();




    }



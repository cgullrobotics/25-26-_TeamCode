        sleep(900);
        ballTransfer.setPower(0);
        sleep(1000);
        ballTransfer.setPower(-1);
        sleep(900);
        ballTransfer.setPower(0);
        sleep(1000);
        ballTransfer.setPower(-1);
        sleep(1000);
        ballTransfer.setPower(0);
    }

    @Override
    public void runOpMode(){
        leftFront = hardwareMap.get(DcMotor.class, "leftFront");
        leftBack = hardwareMap.get(DcMotor.class, "leftBack");
        rightBack = hardwareMap.get(DcMotor.class, "rightBack");
        rightFront = hardwareMap.get(DcMotor.class, "rightFront");
        intake = hardwareMap.get(DcMotor.class, "intake");
        shooter = hardwareMap.get(DcMotorEx.class, "shooter");
        shooter2 = hardwareMap.get(DcMotorEx.class,"shooter2");
        turret = hardwareMap.get(DcMotor.class, "turret");
        angle = hardwareMap.get(Servo.class,"angle");
        pwmLight = hardwareMap.get(Servo.class,"pwmLight");
        ballTransfer = hardwareMap.get(CRServo.class, "ballTransfer");
        distance = hardwareMap.get(DigitalChannel.class,"distance");
        limelight = hardwareMap.get(Limelight3A.class,"limelight");
        pwmLight2 = hardwareMap.get(Servo.class,"pwmLight2");
        swingbar = hardwareMap.get(Servo.class,"swingbar");

        distance.setMode(DigitalChannel.Mode.INPUT);
        shooter.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        shooter2.setMode(DcMotor.RunMode.RUN_USING_ENCODER);

        limelight.setPollRateHz(100);
        limelight.pipelineSwitch(1);
        limelight.start();
        telemetry.addData(">", "robot ready . press play");
        telemetry.update();

        leftFront.setDirection(DcMotor.Direction.FORWARD);
        leftBack.setDirection(DcMotor.Direction.FORWARD);
        rightFront.setDirection(DcMotor.Direction.REVERSE);
        rightBack.setDirection(DcMotor.Direction.REVERSE);
        intake.setDirection(DcMotor.Direction.REVERSE);
        shooter.setDirection(DcMotor.Direction.FORWARD);
        shooter2.setDirection(DcMotor.Direction.REVERSE);
        turret.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);

        waitForStart();
        runtime.reset();

        while (opModeIsActive()){
            driveTrain();
            intakeControl();
            angleManualOverride();
            turretManualOverride();
            shooterControl();
            robotShutdowns();
            double timeLeft = countdownSeconds - timer.seconds();

            if (timeLeft < 0) timeLeft = 0;  // prevent negative numbers

            telemetry.addData("Time Left", timeLeft);

            telemetry.update();
        }
    }
    public void driveTrain(){
        double x = -gamepad1.left_stick_y;
        double y = gamepad1.left_stick_x;
        double z = (gamepad1.right_stick_x);

        double leftFrontPower = x - y + z;
        double leftBackPower = x + y + z;
        double rightFrontPower = x - y - z;
        double rightBackPower = x + y - z;

        leftFront.setPower(leftFrontPower);
        leftBack.setPower(leftBackPower);
        rightFront.setPower(rightFrontPower);
        rightBack.setPower(rightBackPower);
        if(gamepad1.dpad_up){
            limelight.pipelineSwitch(0);
        }
        if(gamepad1.dpad_down){
            limelight.pipelineSwitch(1);
        }
        if (gamepad1.a){
            leftFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
            rightFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
            rightBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
            leftBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        } else if (gamepad1.b) {
            leftFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
            rightFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
            rightBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
            leftBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        }
    }
    public boolean shooterRunning() {
        double rpm = (shooter.getVelocity() / 28.0) * 60.0;
        return rpm >= SHOOTER_MIN_RPM;
    }
    public boolean intakeControl() {
        boolean stateHigh = distance.getState();
        boolean detected = stateHigh;
        boolean shooterReady = shooterRunning();

        if (gamepad1.left_bumper) {
            intake.setPower(0);
        } else if (gamepad1.right_bumper) {
            intake.setPower(-1);
        } else if (gamepad1.y) {
            intake.setPower(1);
        }

        if (gamepad2.right_bumper) {
            ballTransfer.setPower(-0.5);
            intake.setPower(-1);
        } else if (gamepad2.left_bumper) {
            ballTransfer.setPower(0.5);
        } else {
            ballTransfer.setPower(0);
        }

        if (gamepad2.dpad_left) {
            swingbar.setPosition(.1);
        } else if (gamepad2.dpad_right) {
            swingbar.setPosition(0);
        }

        telemetry.addData("Ball Detected", detected);


        return stateHigh;
    }
    public void shooterControl(){
            // ---- Constants ----
            final double COUNTS_PER_REV = 28;
            final double MIN_RPM = 2500;
            final double MAX_RPM = 2920;

            // ---- STOP shooter ----
            if (gamepad2.x) {
                targetRPM = 0;
                shooter.setPower(0);
                shooter2.setPower(0);
                filteredRPM = 0;
                return;
            }

            // ---- Get Limelight result safely ----
            LLResult result = limelight.getLatestResult();
            boolean hasTarget = (result != null && result.isValid());

            // ---- Select RPM mode ----
            if (gamepad2.a) {
                // Close preset
                targetRPM = 2400;
            }
            else if (gamepad2.b) {
                // Far preset
                targetRPM = 2990;
            }
            else if (hasTarget) {
                // Limelight auto RPM
                double ty = result.getTy();
                targetRPM = (m * ty) + b;
            }
            else {
                // No target, no preset → idle
                targetRPM = 0;
            }

            // ---- Clamp RPM ----
            targetRPM = Math.max(MIN_RPM, Math.min(MAX_RPM, targetRPM));

            // ---- Smooth RPM ----
            filteredRPM += rpmAlpha * (targetRPM - filteredRPM);

            // ---- Convert RPM → ticks/sec ----
            double ticksPerSecond = (filteredRPM / 60.0) * COUNTS_PER_REV;

            shooter.setVelocity(ticksPerSecond);
            shooter2.setVelocity(ticksPerSecond);

            // ---- Actual RPM (for logic + telemetry) ----
            double currentRPM = (shooter.getVelocity() / COUNTS_PER_REV) * 60.0;

            // ---- Distance sensor (beam break usually inverted) ----
            boolean ballDetected = !distance.getState();

            // ---- LEDs ----
            pwmLight.setPosition(ballDetected ? 0.0 : 0.5);

            // ---- Telemetry ----
            telemetry.addData("Target RPM", targetRPM);
            telemetry.addData("Shooter RPM", currentRPM);
            telemetry.addData("Limelight", hasTarget ? "Locked" : "No Target");
    }
    public void turretControl(){
        turret.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        LLResult result = limelight.getLatestResult();
        double tx = 0;
        double ta = 0;
        double targetArea = 0;
        double motorPower = 0;
        if (result == null || !result.isValid()) {
            turret.setPower(0);
            telemetry.addData("Limelight", "No target");
        }
        if (result !=null&& result.isValid()){
            tx = result.getTx();
            double ty = result.getTy();
            ta = result.getTa();

            telemetry.addData("Target X", tx);
            telemetry.addData("Target Y", ty);
            telemetry.addData("Target Area", ta);
            double rpm = (shooter.getVelocity() / 28) * 60.0;
            telemetry.addData("Shooter RPM", rpm);
        }
        else {
            telemetry.addData("limelight","No targets");
        }
// Variables for PID
        double target = 0; // Desired tx value (centered on target)

// Inside your loop:
        double error = target - tx;

// Integral term (only accumulate when error is small to avoid windup)
        if (Math.abs(error) < 10) {
            integral += error;
        } else {
            integral = 0.0;
        }
// Derivative term
        double derivative = error - previousError;
        previousError = error;

// PID output
        double turnPower = (kP * error) + (kI * integral) + (kD * derivative);

// Clamp power to avoid excessive speed
        turnPower = Math.max(-.9, Math.min(.9, turnPower));

// Stop condition: target centered and close enough
        if (Math.abs(error) < 0.1 && ta > .4) {
            turret.setPower(0);
            telemetry.addData("Status", "Aligned!");
        } else {
            turret.setPower(-turnPower);
        }
    }
    public void angleManualOverride(){
        if (gamepad2.dpad_down){
            angle.setPosition(angle.getPosition()+.001);
        }
        else if (gamepad2.dpad_up){
            angle.setPosition(angle.getPosition()-.001);
        }
        if (gamepad2.y){
            angle.setPosition(.556);
        }
        else if (gamepad2.a) {
            angle.setPosition(.556);
        }
    }

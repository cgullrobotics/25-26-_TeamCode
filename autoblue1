    @Override
    public void runOpMode() {

        initHardware();
        odo.resetPosAndIMU();
        // ---------------- INIT LOOP ----------------
        while (!isStarted() && !isStopRequested()) {
            odo.update();
            telemetry.addData("X", odo.getPosX(DistanceUnit.INCH));
            telemetry.addData("Y", odo.getPosY(DistanceUnit.INCH));
            telemetry.addData("Heading", odo.getHeading(AngleUnit.DEGREES));
            telemetry.addLine("Ready.");
            telemetry.update();
            LLResult result = limelight.getLatestResult();

            if(result != null && result.isValid()){

                double tx = result.getTx();
                double turretPower = tx * 0.01;

                turret.setPower(turretPower);
            }
            // Example turret preset in init
            if (gamepad1.a) {
                turret.setTargetPosition(-500);
                turret.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                turret.setPower(0.3);
                angle.setPosition(.65);
            }
        }

        waitForStart();
        if (isStopRequested()) return;

        // ---------------- AUTO SEQUENCE ----------------

        // lock heading from start
        telemetry.addData("X", odo.getPosX(DistanceUnit.INCH));
        telemetry.addData("Y", odo.getPosY(DistanceUnit.INCH));
        telemetry.addData("Heading", odo.getHeading(AngleUnit.DEGREES));
        telemetry.addData("Target", targetHeading);
        odo.update();
        LLResult result = limelight.getLatestResult();
        telemetry.update();if(result != null && result.isValid()){

            double tx = result.getTx();
            double turretPower = tx * 0.01;

            turret.setPower(turretPower);
        }
        turretControl();
        intakeidle();

        // Spin up shooter and fire first 3 ball
        spinUpShooter(3000);
        driveToPoint(0, 16.49, 0.93,0.02);
        fireSequence();
        // Move forward with heading lock
        intakeon();
        driveToPoint(23.96, 29.54, 0,0.02);
        intakeon();
        driveToPoint(45.64, 28.34, 0,0.02);
        intakeidle();
        spinUpShooter(3100);
        driveToPoint(0, 0, 0,0.02);
       fireSequence();
        driveToPoint(52.58, -10.09,2.79, 0.04);// adjust units and kP as needed
        intakeon();
        driveToPoint(.50,4.48,0,0.02);
        firesequence2();
        intakeoff();
        // Fire second batch

        stopDrive();
    }


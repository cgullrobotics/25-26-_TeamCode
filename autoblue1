    // ================= DRIVE TO POINT WITH HEADING LOCK =================
    private void driveToPoint(double targetX_INCH, double targetY_INCH, double targetHeading, double speed) {
        double kD_drive = 0.005;   // damping term
        double lastErrorX = 5.0;
        double lastErrorY = 0;

        double timeout = 3.0; // seconds safety
        double startTime = getRuntime();

        while (opModeIsActive()) {
            if (getRuntime() - startTime > timeout) break;

            odo.update();

            double currentX = odo.getPosX(DistanceUnit.INCH);
            double currentY = odo.getPosY(DistanceUnit.INCH);

            double errorX = targetX_INCH - currentX;
            double errorY = targetY_INCH - currentY;

            double distance = Math.hypot(errorX, errorY);

            if (distance < 0.75) break;  // tighter tolerance

            // ===== PD CONTROL =====
            double derivativeX = errorX - lastErrorX;
            double derivativeY = errorY - lastErrorY;

            lastErrorX = errorX;
            lastErrorY = errorY;

            double forward = (errorX * kP) + (derivativeX * kD_drive);
            double strafe  = (errorY * kP) + (derivativeY * kD_drive);

            // ===== FIELD CENTRIC ROTATION =====
            double headingRad = Math.toRadians(odo.getHeading(AngleUnit.RADIANS));
            double tempForward = forward * Math.cos(-headingRad) - strafe * Math.sin(-headingRad);
            double tempStrafe  = forward * Math.sin(-headingRad) + strafe * Math.cos(-headingRad);

            forward = tempForward;
            strafe  = tempStrafe;

            // ===== SLOW DOWN ZONE =====
            double scale = Math.min(.75, distance / 10.0);
            forward *= scale;
            strafe  *= scale;
            // ===== MIN POWER FLOOR =====
            double minPower = 0.08;
            if (Math.abs(forward) < minPower && Math.abs(forward) > 0.01)
                forward = Math.signum(forward) * minPower;

            if (Math.abs(strafe) < minPower && Math.abs(strafe) > 0.01)
                strafe = Math.signum(strafe) * minPower;

            // ===== HEADING / LIMELIGHT LOCK =====
            double turnPower;

            if (limelightLock) {
                LLResult result = limelight.getLatestResult();
                if (result != null && result.isValid()) {
                    double tx = result.getTx();
                    turnPower = tx * kP_limelight;
                } else {
                    turnPower = 0;
                }
            } else {
                double currentHeading = odo.getHeading(AngleUnit.DEGREES);
                double headingError = targetHeading - currentHeading;

                while (headingError > 180) headingError -= 360;
                while (headingError < -180) headingError += 360;

                turnPower = headingError * kP_heading;
            }

            // Clamp
            turnPower = Math.max(-0.9, Math.min(0.9, turnPower));

            mecanumDrive(forward, strafe, turnPower);

            telemetry.addData("TargetX", targetX_INCH);
            telemetry.addData("TargetY", targetY_INCH);
            telemetry.addData("Error", distance);
            telemetry.update();
            TelemetryPacket packet = new TelemetryPacket();
            Canvas field = packet.fieldOverlay();

// Draw robot position
            double robotX = currentX;
            double robotY = currentY;
            double robotHeading = odo.getHeading(AngleUnit.DEGREES);

// Draw robot as circle
            field.setStroke("blue");
            field.strokeCircle(robotX, robotY, 9);

// Draw heading line
            double headingX = robotX + 12 * Math.cos(headingRad);
            double headingY = robotY + 12 * Math.sin(headingRad);
            field.strokeLine(robotX, robotY, headingX, headingY);

// Draw target point
            field.setStroke("red");
            field.strokeCircle(targetX_INCH, targetY_INCH, 5);
            packet.put("X", currentX);
            packet.put("Y", currentY);
            packet.put("HeadingDeg", odo.getHeading(AngleUnit.DEGREES));
            packet.put("TargetX", targetX_INCH);
            packet.put("TargetY", targetY_INCH);
            packet.put("DistanceError", distance);
            packet.put("ForwardPower", forward);
            packet.put("StrafePower", strafe);
            packet.put("turretpower",turnPower);

// Draw line to target
            field.strokeLine(robotX, robotY, targetX_INCH, targetY_INCH);

// Send packet
            dashboard.sendTelemetryPacket(packet);


        }

        stopDrive();
    }

    // ================= MECANUM DRIVE WITH HEADING LOCK =================
    private void mecanumDrive(double forward, double strafe, double turn) {

        // heading correction
        double currentHeading = odo.getHeading(AngleUnit.DEGREES);
        double headingError = targetHeading - currentHeading;

        // Wrap heading properly
        while (headingError > 180) headingError -= 360;
        while (headingError < -180) headingError += 360;

        double turnPower = turn;

        // Only correct if we're off by more than 1 degree
        if (Math.abs(headingError) > .001) {
            turnPower = headingError * kP_heading;
        }

        double lf = forward - strafe + turnPower;
        double rf = forward - strafe - turnPower;
        double lb = forward + strafe + turnPower;
        double rb = forward + strafe - turnPower;

        double max = Math.max(
                Math.max(Math.abs(lf), Math.abs(rf)),
                Math.max(Math.abs(lb), Math.abs(rb))
        );

        if (max > 1) {
            lf /= max;
            rf /= max;
            lb /= max;
            rb /= max;
        }

        leftFront.setPower(lf);
        rightFront.setPower(rf);
        leftBack.setPower(lb);
        rightBack.setPower(rb);
    }

    private void stopDrive() {
        mecanumDrive(0,0,0);
    }

    // ================= SHOOTER =================
    private void spinUpShooter(double rpm) {
        double ticksPerSecond = (rpm / 60.0) * 26;
        shooter.setVelocity(ticksPerSecond);
        shooter2.setVelocity(ticksPerSecond);
    }


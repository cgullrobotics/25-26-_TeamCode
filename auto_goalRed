@Autonomous(name="Auto_goalRed")

public class Auto_goalRed extends LinearOpMode {
    private DcMotor leftFront, intake, leftback, rightFront, rightBack,  turret;
    private Servo angle;
    private DcMotorEx shooter;
    private CRServo ballTransfer;
    private double kP, kI, kD;
    private double integral, previousError;
    Limelight3A limelight;
    private IMU imu;
    private DigitalChannel distance;

    public int StateCounter = 1;


    @Override
    public void runOpMode() throws InterruptedException {
        leftFront = hardwareMap.get(DcMotor.class, "leftFront");
        leftback = hardwareMap.get(DcMotor.class, "leftBack");
        rightFront = hardwareMap.get(DcMotor.class, "rightFront");
        rightBack = hardwareMap.get(DcMotor.class, "rightBack");
        intake = hardwareMap.get(DcMotor.class, "intake");
        shooter = hardwareMap.get(DcMotorEx.class,"shooter");
        turret = hardwareMap.get(DcMotor.class, "turret");
        angle = hardwareMap.get(Servo.class,"angle");
        ballTransfer = hardwareMap.get(CRServo.class, "ballTransfer");
        distance = hardwareMap.get(DigitalChannel.class,"distance");
        imu = hardwareMap.get(IMU.class, "imu");
        distance.setMode(DigitalChannel.Mode.INPUT);

        // Set correct orientation of the hub (adjust for your robot!)
        imu.initialize(new IMU.Parameters(
                new RevHubOrientationOnRobot(
                        RevHubOrientationOnRobot.LogoFacingDirection.RIGHT,
                        RevHubOrientationOnRobot.UsbFacingDirection.UP
                )
                ));

        leftFront.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        leftback.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        rightFront.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        rightBack.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        turret.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        limelight = hardwareMap.get(Limelight3A.class,"limelight");
        shooter.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        limelight.setPollRateHz(100); // This sets how often we ask Limelight for data (100 times per second)
        limelight.start(); // This tells Limelight to start looking!
        limelight.pipelineSwitch(0);


        waitForStart();
        while (opModeIsActive()) {
            telemetry.update();
            telemetry.addData("leftfront",leftFront.getCurrentPosition());
            telemetry.addData("rightfront",rightFront.getCurrentPosition());
            telemetry.addData("leftback",leftback.getCurrentPosition());
            telemetry.addData("rightback",rightBack.getCurrentPosition());
            LLResult result = limelight.getLatestResult();
            double tx = 0;
            double ta = 0;
            if (result != null && result.isValid()) {
                tx = result.getTx();
                double ty = result.getTy(); // How far up or down the target is (degrees)
                ta = result.getTa();

                telemetry.addData("Target X", tx);
                telemetry.addData("Target Y", ty);
                telemetry.addData("Target Area", ta);
            } else {
                telemetry.addData("Limelight", "No Targets");
            }





            switch (StateCounter) {


                case 1: {
                    //move away from goal and shoot
                    int lfPos = leftFront.getCurrentPosition();
                    int target = leftFront.getTargetPosition();

                    int error = Math.abs(target - lfPos);

// Dynamic power based on distance left
                    double maxPower =.8;
                    double minPower = 0.15;

                    double kP = 0.0004; // tune this

                    double power = kP * error;

// Clamp power
                    power = Math.max(minPower, Math.min(maxPower, power));

// Apply to all motors (preserving direction)
                    leftFront.setPower(power * Math.signum(target - lfPos));
                    leftback.setPower(power * Math.signum(leftback.getTargetPosition() - leftback.getCurrentPosition()));
                    rightFront.setPower(power * Math.signum(rightFront.getTargetPosition() - rightFront.getCurrentPosition()));
                    rightBack.setPower(power * Math.signum(rightBack.getTargetPosition() - rightBack.getCurrentPosition()));
                    double targetRPM = 2200;
                    double COUNTS_PER_REVOLUTION = 28; // Example: Adjust for your specific motor
                    double ticksPerSecond = (targetRPM / 60.0) * COUNTS_PER_REVOLUTION;
                    shooter.setVelocity(ticksPerSecond);
                    telemetry.addData("shooter rpm",ticksPerSecond);
                    leftFront.setTargetPosition(-700);
                    leftback.setTargetPosition(-708);
                    rightFront.setTargetPosition(677);
                    rightBack.setTargetPosition(709);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(.8);
                    leftback.setPower(.8);
                    rightFront.setPower(.8);
                    rightBack.setPower(.8);
                    sleep(2500);

                    if(ticksPerSecond< 2099){
                        sleep(2500);
                    ballTransfer.setPower(-1);
                    sleep(800);
                    ballTransfer.setPower(0);
                    intake.setPower(1);
                    sleep(1420);
                    ballTransfer.setPower(-1);
                    sleep(1800);
                    ballTransfer.setPower(0);
                    intake.setPower(0);}
                    sleep(2200);
                    StateCounter=2;
                    break;
                }
                case 2: {
                    //turn to pickup more artifacts
                    leftFront.setTargetPosition(-1702);
                    leftback.setTargetPosition(-1084);
                    rightFront.setTargetPosition(2455);
                    rightBack.setTargetPosition(1930);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(-1);
                    leftback.setPower(1);
                    rightFront.setPower(-1);
                    rightBack.setPower(1);
                    sleep(500);
                    leftFront.setTargetPosition(-1728);
                    leftback.setTargetPosition(-221);
                    rightFront.setTargetPosition(2518);
                    rightBack.setTargetPosition(754);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(-1);
                    leftback.setPower(1);
                    rightFront.setPower(1);
                    rightBack.setPower(-1);
                    sleep(2500);

                    StateCounter = 3;

                    break;

                }
                case 3: {
                    boolean stateHigh = distance.getState();
                    boolean detected = stateHigh;
                    boolean NotDetected = stateHigh;

                    //move forword to grab more artifacts
                    intake.setPower(1);
                    leftFront.setTargetPosition(-583);
                    leftback.setTargetPosition(795);
                    rightFront.setTargetPosition(1372);
                    rightBack.setTargetPosition(-316);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(.22);
                    leftback.setPower(.22);
                    rightFront.setPower(.22);
                    rightBack.setPower(.22);
                    sleep(1900);
                    StateCounter = 0;

                }
                case 4: {


                    intake.setPower(0);
                    double targetRPM = 2150;
                    double COUNTS_PER_REVOLUTION = 28; // Example: Adjust for your specific motor
                    double ticksPerSecond = (targetRPM / 60.0) * COUNTS_PER_REVOLUTION;
                    shooter.setVelocity(ticksPerSecond);

                    leftFront.setTargetPosition(-25);
                    leftback.setTargetPosition(-2073);
                    rightFront.setTargetPosition(162);
                    rightBack.setTargetPosition(1560);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(.8);
                    leftback.setPower(-.8);
                    rightFront.setPower(.8);
                    rightBack.setPower(-.8);


                    sleep(2000);
                    intake.setPower(1);
                    if (ticksPerSecond<2145){
                        sleep(2500);
                    ballTransfer.setPower(-1);
                    sleep(1000);
                    ballTransfer.setPower(0);
                    sleep(1520);
                    ballTransfer.setPower(-1);
                    sleep(600);
                    ballTransfer.setPower(0);
                    intake.setPower(0);}
                    sleep(3500);
                    terminateOpModeNow();
                    StateCounter = 5;
                    break;
                }
                case 5: {
                    intake.setPower(1);
                    leftFront.setTargetPosition(-679);
                    leftback.setTargetPosition(4546);
                    rightFront.setTargetPosition(-4287);
                    rightBack.setTargetPosition(700);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(.3);
                    leftback.setPower(-.3);
                    rightFront.setPower(-.3);
                    rightBack.setPower(.3);



                    sleep(2500);
                    StateCounter = 6;

                }
                case 6: {

                    intake.setPower(0);
                    leftFront.setTargetPosition(-2576);
                    leftback.setTargetPosition(3251);
                    rightFront.setTargetPosition(-3038);
                    rightBack.setTargetPosition(2625);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(-1);
                    leftback.setPower(1);
                    rightFront.setPower(1);
                    rightBack.setPower(-1);



                    sleep(5000);
                    StateCounter = 0;
                }
                case 7: {
                    shooter.setPower(.75);

                    ballTransfer.setPower(.3);
                    sleep(300);
                    ballTransfer.setPower(0);
                    sleep(500);
                    ballTransfer.setPower(.3);
                    sleep(300);
                    ballTransfer.setPower(0);
                    sleep(3000);

                    leftFront.setTargetPosition(-1884);
                    leftback.setTargetPosition(4951);
                    rightFront.setTargetPosition(-4709);
                    rightBack.setTargetPosition(1937);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(-.8);
                    leftback.setPower(-.8);
                    rightFront.setPower(.8);
                    rightBack.setPower(.8);


                    sleep(3000);
                    StateCounter = 0;
                }
                case 8:{
                    intake.setPower(1);
                    leftFront.setTargetPosition(-1496);
                    leftback.setTargetPosition(-2239);
                    rightFront.setTargetPosition(2306);
                    rightBack.setTargetPosition(1515);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(.3);
                    leftback.setPower(.3);
                    rightFront.setPower(-.3);
                    rightBack.setPower(-.3);
                    sleep(1000);
                    intake.setPower(0);
                    sleep(1500);
                    StateCounter = 0;

                }
                case  9:{
                    leftFront.setTargetPosition(-156);
                    leftback.setTargetPosition(-948);
                    rightFront.setTargetPosition(940);
                    rightBack.setTargetPosition(135);
                    leftFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftback.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightBack.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    rightFront.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    leftFront.setPower(1);
                    leftback.setPower(1);
                    rightFront.setPower(-1);
                    rightBack.setPower(-1);

                }
            }

        }
    }
}
